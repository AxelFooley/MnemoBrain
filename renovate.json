{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["src/mnemobrain/config.py"],
      "matchStrings": ["\"MNEMOBRAIN_MNEMOSYNE_VERSION\": \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "mnemosyne-memory"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["src/mnemobrain/config.py"],
      "matchStrings": ["\"MNEMOBRAIN_GBRAIN_REF\": \"(?<currentValue>[^\"]+)\""],
      "datasourceTemplate": "github-tags",
      "depNameTemplate": "garrytan/gbrain"
    }
  ]
}
